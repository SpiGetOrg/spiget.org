---
// Fetches a code example at build time and highlights it. Falls back to a link if the fetch fails.
import { Code } from 'astro:components';

interface Props {
  url: string;
  lang: string;
}
const { url, lang } = Astro.props;

let code: string | null = null;
try {
  const response = await fetch(url, { signal: AbortSignal.timeout(15_000) });
  if (response.ok) code = (await response.text()).trim();
} catch {
  // Network error, show the link instead
}
---

{
  code ? (
    <div class="code-block">
      <Code code={code} lang={lang as any} themes={{ light: 'github-light', dark: 'github-dark' }} defaultColor="light" />
    </div>
  ) : (
    <p>
      <a href={url} target="_blank" rel="noopener">
        View the example code
      </a>
    </p>
  )
}
