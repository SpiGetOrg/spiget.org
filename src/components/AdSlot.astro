---
// Google AdSense unit. Markup is unchanged from the PHP site.
interface Props {
  slot: string;
}
const { slot } = Astro.props;
---

<div class="ad-slot">
  <script is:inline async src="//pagead2.googlesyndication.com/pagead/js/adsbygoogle.js"></script>
  <ins
    class="adsbygoogle"
    style="display:block"
    data-ad-client="ca-pub-2604356629473365"
    data-ad-slot={slot}
    data-ad-format="auto"
    data-full-width-responsive="true"></ins>
  <script is:inline>
    (adsbygoogle = window.adsbygoogle || []).push({});
  </script>
</div>
