---
import Layout from '../layouts/Layout.astro';
import AdSlot from '../components/AdSlot.astro';
---

<Layout title="Status" description="Status and request statistics of the Spiget API">
  <div class="container-fluid">
    <div class="row">
      <div class="col-lg-2 pt-4">
        <AdSlot slot="3613794533" />
      </div>

      <div class="col-lg-7">
        <h1 class="page-header">Status</h1>

        <div id="api-status-panel" class="card border-warning">
          <div class="card-header bg-warning-subtle text-warning-emphasis d-flex justify-content-between" id="api-status-header">
            <span><strong>API</strong> | <span id="api-status">Checking…</span></span>
            <a href="http://status.spiget.org/" target="_blank" rel="noopener"><strong>Details</strong></a>
          </div>
          <div class="card-body">
            <div id="server-container"></div>
            <hr />
            <div class="fetcher-status" id="fetcher-status">Checking Fetcher Status…</div>
            <div class="fetcher-details" id="fetcher-details"></div>
            <hr />
            <h2 class="h5 text-center">Daily Requests</h2>
            <div class="chart-box" id="daily-requests-box">
              <canvas id="daily-requests-chart" aria-label="Daily API requests over the last 30 days" role="img"></canvas>
            </div>
          </div>
        </div>
      </div>

      <div class="col-lg-3 pt-4">
        <AdSlot slot="6494452201" />
      </div>
    </div>
  </div>
</Layout>

<script>
  import {
    Chart,
    CategoryScale,
    Filler,
    Legend,
    LinearScale,
    LineController,
    LineElement,
    PointElement,
    Tooltip,
  } from 'chart.js';
  import { apiGet, el, formatNumber, fromNow } from '../scripts/api';

  Chart.register(CategoryScale, Filler, Legend, LinearScale, LineController, LineElement, PointElement, Tooltip);

  // API servers watched on UptimeRobot (read-only monitor keys, same as the old site)
  const SERVERS = [
    {
      name: 'apple',
      color: 'aqua',
      url: 'https://apple.api.spiget.org',
      apiKey: 'm778498607-51f8a0a2cba2102642c5264c',
    },
  ];

  const ICONS = {
    checking: { icon: 'bi-question-circle-fill', color: 'gray', label: 'Checking' },
    up: { icon: 'bi-check-circle-fill', color: '#00b900', label: 'Online' },
    down: { icon: 'bi-x-circle-fill', color: 'red', label: 'Offline' },
  } as const;

  function setIcon(element: HTMLElement, state: keyof typeof ICONS) {
    const { icon, color, label } = ICONS[state];
    element.className = `bi ${icon}`;
    element.style.color = color;
    element.setAttribute('aria-label', label);
  }

  async function isServerUp(apiKey: string): Promise<boolean> {
    const response = await fetch(`https://api.uptimerobot.com/v2/getMonitors?format=json&api_key=${apiKey}`, {
      method: 'POST',
      signal: AbortSignal.timeout(10_000),
    });
    const body = await response.json();
    // v2 returns `monitors: [...]`, v1 returned `monitors: { monitor: [...] }`
    const monitor = Array.isArray(body.monitors) ? body.monitors[0] : body.monitors?.monitor?.[0];
    // 0 paused, 1 not checked yet, 2 up, 8 seems down, 9 down
    return monitor !== undefined && monitor.status <= 2;
  }

  function setGlobalStatus(online: number, total: number) {
    const panel = document.getElementById('api-status-panel')!;
    const header = document.getElementById('api-status-header')!;
    const text = document.getElementById('api-status')!;
    let tone = 'warning';
    if (online >= total) {
      tone = 'success';
      text.textContent = 'All servers online!';
    } else if (online <= 0) {
      tone = 'danger';
      text.textContent = 'All servers are offline';
    } else {
      text.textContent = `${online}/${total} servers online`;
    }
    panel.className = `card border-${tone}`;
    header.className = `card-header bg-${tone}-subtle text-${tone}-emphasis d-flex justify-content-between`;
  }

  async function checkServers() {
    const container = document.getElementById('server-container')!;
    const checks = SERVERS.map(async (server) => {
      const icon = el('i', { role: 'img' });
      const circle = el('div', { class: 'server' }, el('a', { href: server.url, target: '_blank', rel: 'noopener', title: server.name }, icon));
      circle.style.background = server.color;
      container.append(circle);
      setIcon(icon, 'checking');

      // Master/slave border
      fetch(`${server.url}/v2/status`, { signal: AbortSignal.timeout(8_000) })
        .then((response) => response.json())
        .then((body) => circle.classList.add(`mode-${body.status.server.mode}`))
        .catch(() => {});

      try {
        const up = await isServerUp(server.apiKey);
        setIcon(icon, up ? 'up' : 'down');
        return up;
      } catch {
        setIcon(icon, 'down');
        return false;
      }
    });
    const results = await Promise.all(checks);
    setGlobalStatus(results.filter(Boolean).length, SERVERS.length);
  }

  async function checkFetcher() {
    const status = document.getElementById('fetcher-status')!;
    const details = document.getElementById('fetcher-details')!;
    try {
      const response = await apiGet<{ status: { fetch: { active: boolean; start: number; end: number } } }>('/status');
      const { active, start, end } = response.status.fetch;
      if (active) {
        status.replaceChildren('The API is ', el('span', { class: 'updating' }, 'currently updating'));
        details.replaceChildren('The update started ', el('span', { class: 'time' }, fromNow(start)));
      } else {
        status.replaceChildren('The API is ', el('span', { class: 'updated' }, 'up to date'));
        details.replaceChildren('It was last updated ', el('span', { class: 'time' }, fromNow(end > 0 ? end : start)));
      }
    } catch {
      status.textContent = 'Fetcher status is not available right now';
    }
  }

  /** Least-squares line through the points, for the trend series */
  function trendLine(values: number[]): number[] {
    const n = values.length;
    if (n < 2) return values.slice();
    const meanX = (n - 1) / 2;
    const meanY = values.reduce((a, b) => a + b, 0) / n;
    let numerator = 0;
    let denominator = 0;
    values.forEach((y, x) => {
      numerator += (x - meanX) * (y - meanY);
      denominator += (x - meanX) ** 2;
    });
    const slope = numerator / denominator;
    return values.map((_, x) => Math.round(meanY + slope * (x - meanX)));
  }

  async function drawChart() {
    const box = document.getElementById('daily-requests-box')!;
    const canvas = document.getElementById('daily-requests-chart') as HTMLCanvasElement;
    try {
      const metrics = await apiGet<{ timestamp: number; total: number; unique: number }[]>(
        '/metrics/requests/30',
        {},
        { timeoutMs: 10_000 },
      );
      const days = Object.values(metrics).sort((a, b) => a.timestamp - b.timestamp);
      const dateFormat = new Intl.DateTimeFormat('en', { weekday: 'short', month: 'short', day: 'numeric' });
      const dark = document.documentElement.getAttribute('data-bs-theme') === 'dark';
      const totals = days.map((day) => day.total);

      new Chart(canvas, {
        type: 'line',
        data: {
          // The API sends milliseconds; older responses used seconds
          labels: days.map((day) => dateFormat.format(new Date(day.timestamp > 1e12 ? day.timestamp : day.timestamp * 1000))),
          datasets: [
            { label: 'total', data: totals, borderColor: dark ? '#e9ecef' : 'black', backgroundColor: dark ? '#e9ecef' : 'black' },
            { label: 'unique', data: days.map((day) => day.unique), borderColor: '#3b82f6', backgroundColor: '#3b82f6', hidden: true },
            { label: 'trend', data: trendLine(totals), borderColor: 'gray', backgroundColor: 'gray', borderDash: [6, 4] },
          ],
        },
        options: {
          maintainAspectRatio: false,
          interaction: { mode: 'index', intersect: false },
          elements: { line: { tension: 0.35, borderWidth: 2 }, point: { radius: 0, hoverRadius: 4 } },
          scales: {
            y: { title: { display: true, text: 'Number of Requests' }, ticks: { callback: (value) => formatNumber(Number(value)) } },
          },
          plugins: {
            tooltip: { callbacks: { label: (item) => `${item.dataset.label}: ${formatNumber(Number(item.raw))}` } },
          },
        },
      });
    } catch {
      box.replaceChildren(el('p', { class: 'text-body-secondary text-center my-5' }, 'Request statistics are not available right now.'));
      box.style.height = 'auto';
    }
  }

  checkServers();
  checkFetcher();
  drawChart();
</script>
